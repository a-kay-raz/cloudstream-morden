<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="?attr/primaryBlackBackground"/>
    <!-- Glass Phase 2: theme-adaptive light edge (white_attr_20 flips
         per theme variant, like dialog__window_background), so the
         search pill reads as glass instead of a flat band. Solid
         stays the theme surface so LightMode is not broken by a
         fixed dark translucent fill. -->
    <stroke android:width="1dp" android:color="@color/white_attr_20" />
</shape>
