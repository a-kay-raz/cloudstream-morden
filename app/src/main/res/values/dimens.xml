    <dimen name="storage_radius">8dp</dimen>
    <dimen name="navbar_width">0dp</dimen>

    <dimen name="nav_view_height">70dp</dimen>
    <!-- Phase 8.95: PHONE bottom bar only — the Material 3
         standard 80dp for icon+label mode. The 70dp above stays
         for the TV layout, which shares nav_view_height and is
         untouched. At 70dp the labeled item layout (indicator
         pill + 24dp icon + 12sp label) did not fit and the
         labels were clipped at the bottom on device. -->
    <dimen name="nav_view_height_phone">80dp</dimen>
    <dimen name="nav_rail_view_width">62dp</dimen>

